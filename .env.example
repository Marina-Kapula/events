# Copy to .env (git-ignored) for local development: cp .env.example .env
# Real environment variables override the values in .env.

# true for local development only. When false, DJANGO_SECRET_KEY is required.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG is false. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# Left empty, a fixed development key is used (only allowed while DJANGO_DEBUG is true).
DJANGO_SECRET_KEY=

# Comma-separated host names this site may serve.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# true only behind an HTTPS proxy (Dokku's nginx): trusts its X-Forwarded-Proto header and
# turns on secure cookies and HSTS.
DJANGO_HTTPS=false

# SQLite database file; a relative path resolves against the project root.
DJANGO_DB_PATH=var/db.sqlite3

DJANGO_TIME_ZONE=Europe/Rome

# Email. The file-based backend writes each email to var/mail/ and sends nothing: open the
# newest file there to follow an invitation or password-reset link. To send for real, remove
# EMAIL_BACKEND (or set it to django.core.mail.backends.smtp.EmailBackend) and fill in the rest.
# Production must set EMAIL_HOST and the account: without them SMTP tries localhost:587, and
# every email fails after a 10 s timeout.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true     # STARTTLS
# EMAIL_USE_SSL=false    # implicit TLS, usually port 465; not together with TLS
